# Copied to .env by `make up`. Every value here is for local Docker development only.

POSTGRES_USER=playnex
POSTGRES_PASSWORD=playnex
POSTGRES_DB=playnex
DATABASE_URL=postgres://playnex:playnex@postgres:5432/playnex

VALKEY_URL=redis://valkey:6379

STORAGE_ENDPOINT=http://storage:9000
STORAGE_ACCESS_KEY=playnex
STORAGE_SECRET_KEY=playnex-dev-secret
STORAGE_BUCKET=playnex-assets

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
MAIL_FROM=PLAYNEX <no-reply@playnex.localhost>

# The browser never talks to the API; the web server calls it over the Docker network.
API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8081

# Signs guest reconnect tokens; use at least 32 bytes. Left empty, the service
# generates a per-process key and reconnects stop working across restarts.
REALTIME_TOKEN_SECRET=
REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://web:3000

# Bind mounts on Windows and macOS do not deliver file events reliably, so dev servers poll.
# Set to 0 on a Linux host (or with Docker Desktop synchronized file shares) for faster reloads.
WATCH_POLLING=1
