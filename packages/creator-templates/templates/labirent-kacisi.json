    {
      "id": 30,
      "name": "Hayalet",
      "shape": { "kind": "circle" },
      "position": { "x": 0, "y": -5 },
      "size": { "x": 0.9, "y": 0.9 },
      "color": 22,
      "body": "kinematic",
      "sensor": true,
      "tags": ["hayalet"],
      "behaviors": [
        { "kind": "chase", "tag": "player", "speed": 1.8 },
        { "kind": "hazard", "damage": 1 }
      ]
    },
    {
      "id": 40,
      "name": "Çıkış",
      "shape": { "kind": "rect" },
      "position": { "x": 8.5, "y": -5.5 },
      "size": { "x": 1, "y": 1 },
      "color": 13,
      "sensor": true,
      "scripts": [
        {
          "id": "exit-reached",
          "event": { "kind": "collide", "tag": "player" },
          "body": [
            {
              "op": "if",
              "condition": {
                "op": "binary",
                "operator": "eq",
                "left": { "op": "count", "tag": "anahtar" },
                "right": { "op": "number", "value": 0 }
              },
              "then": [
                {
                  "op": "addScore",
                  "amount": {
                    "op": "binary",
                    "operator": "mul",
                    "left": {
                      "op": "binary",
                      "operator": "sub",
                      "left": { "op": "number", "value": 120 },
                      "right": { "op": "unary", "operator": "floor", "value": { "op": "time" } }
                    },
                    "right": { "op": "number", "value": 2 }
                  }
                },
                { "op": "win" }
              ],
              "otherwise": [{ "op": "playSound", "sound": "kilitli" }]
            }
          ]
        }
      ]
    },
    {
      "id": 50,
      "name": "Kaşif",
      "shape": { "kind": "circle" },
      "position": { "x": -8.5, "y": 5.5 },
      "size": { "x": 0.8, "y": 0.8 },
      "color": 16,
      "body": "dynamic",
      "tags": ["player"],
      "behaviors": [{ "kind": "topDownController", "speed": 5 }],
      "scripts": [
        {
          "id": "key-found",
          "event": { "kind": "collide", "tag": "anahtar" },
          "body": [
            { "op": "change", "variable": "kalan anahtar", "by": { "op": "number", "value": -1 } },
            { "op": "playSound", "sound": "anahtar" }
          ]
        },
        {
          "id": "caught",
          "event": { "kind": "message", "name": "hit" },
          "body": [
            { "op": "playSound", "sound": "yakalandı" },
            {
              "op": "setPosition",
              "target": { "kind": "self" },
              "x": { "op": "number", "value": -8.5 },
              "y": { "op": "number", "value": 5.5 }
            },
            {
              "op": "setPosition",
              "target": { "kind": "named", "name": "Hayalet" },
              "x": { "op": "number", "value": 0 },
              "y": { "op": "number", "value": -5 }
            }
          ]
        }
      ]
    }
  ]
