      "shape": { "kind": "rect" },
      "position": { "x": -27, "y": -6 },
      "size": { "x": 1, "y": 1 },
      "color": 18,
      "body": "dynamic",
      "tags": ["player"],
      "behaviors": [
        { "kind": "platformerController", "speed": 7, "jump": 15 },
        { "kind": "cameraTarget" }
      ],
      "scripts": [
        {
          "id": "p-jump",
          "event": { "kind": "pressed", "action": "jump" },
          "body": [
            {
              "op": "if",
              "condition": {
                "op": "property",
                "target": { "kind": "self" },
                "property": "onGround"
              },
              "then": [{ "op": "playSound", "sound": "zıpla" }]
            }
          ]
        },
        {
          "id": "p-coin",
          "event": { "kind": "collide", "tag": "altın" },
          "body": [{ "op": "playSound", "sound": "altın" }]
        },
        {
          "id": "p-hit",
          "event": { "kind": "message", "name": "hit" },
          "body": [
            { "op": "playSound", "sound": "can" },
            { "op": "cameraShake", "strength": { "op": "number", "value": 2 } },
            {
              "op": "setPosition",
              "target": { "kind": "self" },
              "x": { "op": "number", "value": -27 },
              "y": { "op": "number", "value": -6 }
            },
            {
              "op": "setVelocity",
              "target": { "kind": "self" },
              "x": { "op": "number", "value": 0 },
              "y": { "op": "number", "value": 0 }
            }
          ]
        },
        {
          "id": "p-fall",
          "event": { "kind": "tick" },
          "body": [
            {
              "op": "if",
              "condition": {
                "op": "binary",
                "operator": "lt",
                "left": { "op": "property", "target": { "kind": "self" }, "property": "y" },
                "right": { "op": "number", "value": -10 }
              },
              "then": [
                { "op": "loseLife", "amount": { "op": "number", "value": 1 } },
                {
                  "op": "setPosition",
                  "target": { "kind": "self" },
                  "x": { "op": "number", "value": -27 },
                  "y": { "op": "number", "value": -6 }
                },
                { "op": "broadcast", "message": "hit" }
              ]
            }
          ]
        }
      ]
    }
  ]
