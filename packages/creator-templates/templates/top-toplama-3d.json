    {
      "id": 20,
      "name": "Top",
      "shape": { "kind": "sphere" },
      "position": { "x": 0, "y": 0.5, "z": -6 },
      "size": { "x": 1, "y": 1, "z": 1 },
      "color": 18,
      "body": "dynamic",
      "tags": ["player"],
      "behaviors": [{ "kind": "topDownController", "speed": 7 }, { "kind": "cameraTarget" }],
      "scripts": [
        {
          "id": "ball-jump",
          "event": { "kind": "pressed", "action": "jump" },
          "body": [
            {
              "op": "if",
              "condition": {
                "op": "property",
                "target": { "kind": "self" },
                "property": "onGround"
              },
              "then": [
                {
                  "op": "setVelocityAxis",
                  "target": { "kind": "self" },
                  "axis": "y",
                  "value": { "op": "number", "value": 11 }
                },
                { "op": "playSound", "sound": "zıpla" }
              ]
            }
          ]
        },
        {
          "id": "ball-fell",
          "event": { "kind": "tick" },
          "body": [
            {
              "op": "if",
              "condition": {
                "op": "binary",
                "operator": "lt",
                "left": { "op": "property", "target": { "kind": "self" }, "property": "y" },
                "right": { "op": "number", "value": -6 }
              },
              "then": [
                { "op": "loseLife", "amount": { "op": "number", "value": 1 } },
                { "op": "broadcast", "message": "hit" },
                {
                  "op": "setPosition",
                  "target": { "kind": "self" },
                  "x": { "op": "number", "value": 0 },
                  "y": { "op": "number", "value": 1 },
                  "z": { "op": "number", "value": -6 }
                }
              ]
            }
          ]
        },
        {
          "id": "ball-hit",
          "event": { "kind": "message", "name": "hit" },
          "body": [
            { "op": "playSound", "sound": "düştü" },
            { "op": "cameraShake", "strength": { "op": "number", "value": 2 } }
          ]
        }
      ]
    }
  ],
  "scripts": [
    {
      "id": "all-collected",
      "event": { "kind": "tick" },
      "body": [
        {
          "op": "if",
          "condition": {
            "op": "binary",
            "operator": "eq",
            "left": { "op": "count", "tag": "mücevher" },
            "right": { "op": "number", "value": 0 }
          },
          "then": [
            {
              "op": "addScore",
              "amount": {
                "op": "binary",
                "operator": "sub",
                "left": { "op": "number", "value": 60 },
                "right": { "op": "unary", "operator": "floor", "value": { "op": "time" } }
              }
            },
            { "op": "playSound", "sound": "bitti" },
            { "op": "win" }
          ]
        }
      ]
    }
  ]
}
